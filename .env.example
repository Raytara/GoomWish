# Copie ce fichier en « .env » et remplis la clé. Le fichier .env n'est jamais versionné.

# --- Groq : une seule clé pour la transcription (Whisper) ET la lecture de la recette (IA) ---
# Crée une clé sur https://console.groq.com (offre gratuite)
GROQ_API_KEY=

# --- Réglages facultatifs (valeurs par défaut ci-dessous) ---
# Les noms de modèles évoluent : la liste à jour est sur https://console.groq.com/docs/models
# LLM_MODEL=openai/gpt-oss-120b
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=fr

# --- Utiliser un autre fournisseur (compatible OpenAI), par exemple OpenAI ou Kimi ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

# --- Programmes externes ---
# Cookies du navigateur pour les vidéos Instagram privées : firefox, chrome…
# YTDLP_COOKIES_FROM_BROWSER=firefox
# Chemin de la base de données
# DB_PATH=data/recipes.db
